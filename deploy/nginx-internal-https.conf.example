# 与 nginx-https.conf.example 配套。先确认宿主机 TLS 代理的实际 TCP 来源地址，
# 替换 TRUSTED_TLS_PROXY_IP（单个 IP），再以只读方式挂载为 web 的 nginx.conf。
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    client_max_body_size 200k;
    set_real_ip_from TRUSTED_TLS_PROXY_IP;
    real_ip_header X-Forwarded-For;
    real_ip_recursive off;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'" always;
    location /api/ {
        proxy_pass http://backend:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Probe-Client-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Real-IP "";
        proxy_read_timeout 100s;
    }
    location / { try_files $uri $uri/ /index.html; }
}
