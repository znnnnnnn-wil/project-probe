# 本地开发使用 localhost:5173；Compose 本地试部署改为 http://localhost:8088
APP_ORIGIN=http://localhost:5173
SECURE_COOKIE=false
PORT=8080
BIND_ADDRESS=127.0.0.1
# 直连保持空；独立反向代理填写直接连接后端的代理 IP，逗号分隔，不填写访客 IP。
TRUSTED_PROXY_ADDRESSES=
# Compose 固定 Nginx 地址为本专用子网的 .10；修改前检查网络冲突。
PROXY_NETWORK_PREFIX=172.30.88
# Compose 默认前端端口 8088；修改后 APP_ORIGIN 也要同步。
# WEB_PORT=8088
# 隔离验收脚本会显式指定 APP_ENV_FILE，不读取根目录 .env。

# 留空使用 H2 文件数据库。生产和 Compose 使用 PostgreSQL。
# DB_URL=jdbc:postgresql://localhost:5432/projectprobe
# DB_USER=projectprobe
# DB_PASSWORD=replace-with-random-password
POSTGRES_PASSWORD=replace-with-random-password

# demo 为规则演示；live 为真实 OpenAI 兼容服务。浏览器不会收到这些密钥。
MODEL_MODE=demo
MODEL_PROVIDER=OpenAI-compatible
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=
MODEL_API_KEY=
# 百炼可使用 MODEL_PROVIDER=DashScope；当前免费额度候选 qwen3.8-max-0902。
# MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL_NAME=qwen3.8-max-0902
# 单次超时 5–40 秒；两次请求须在 90 秒训练租约内结束。
MODEL_TIMEOUT_SECONDS=30
# 单实例文字模型并发上限，1–32；繁忙时保留可重试状态。
MODEL_MAX_CONCURRENT_CALLS=4
# 每个账号每 24 小时最多发起的事实提取次数（失败也计入）；相同材料复用结果。
EXTRACTION_DAILY_LIMIT=20
# 仅为人工确认记录，不是百炼 API 参数；须先在控制台开启并确认该模型用完即停生效。
MODEL_FREE_QUOTA_CONFIRMED_MODEL=
# 仅百炼：开启后 live 启动要求确认模型匹配；实际停止扣费由控制台开关保证。
MODEL_FREE_QUOTA_ONLY=false

# 三种模式互相隔离；production 需本人完成官方准入与签约，当前运行仍保持 mock。
PAYMENT_MODE=mock
TRAINING_PRICE_CENTS=990
# 创建订单起算的有效期；平台过期查询/关单与现金退款开关独立。
ORDER_TTL_MINUTES=30
PAYMENT_EXPIRY_SYNC_ENABLED=false
# 可选通知丢失补偿，每轮最多10个、创建后24小时内、已发起支付的待支付订单。
PAYMENT_RECONCILE_ENABLED=false
# 关单/现金退款接口默认关闭；本人确认业务规则后在对应环境启用。
PAYMENT_OPERATIONS_ENABLED=false
ALIPAY_SANDBOX_APP_ID=
ALIPAY_SANDBOX_SELLER_ID=
# 本地绝对路径；Compose 仅挂载当前环境目录，容器使用 /run/secrets/alipay/application-private.pem。
ALIPAY_SANDBOX_PRIVATE_KEY_FILE=
ALIPAY_SANDBOX_PUBLIC_KEY_FILE=
ALIPAY_SANDBOX_NOTIFY_URL=
ALIPAY_SANDBOX_RETURN_URL=http://localhost:5173/payment-return
# 人工确认此 APP_ID 属于该卖家；不代表签约通过，也不会自动开通。
ALIPAY_SANDBOX_MERCHANT_CONFIRMED=false
ALIPAY_PRODUCTION_APP_ID=
ALIPAY_PRODUCTION_SELLER_ID=
ALIPAY_PRODUCTION_PRIVATE_KEY_FILE=
ALIPAY_PRODUCTION_PUBLIC_KEY_FILE=
ALIPAY_PRODUCTION_NOTIFY_URL=
ALIPAY_PRODUCTION_RETURN_URL=
ALIPAY_PRODUCTION_MERCHANT_CONFIRMED=false
# Compose 仅挂载所选环境目录；默认 mock 空目录，不挂载沙箱/正式密钥。
# ALIPAY_KEY_DIRECTORY=./.secrets/alipay/sandbox
